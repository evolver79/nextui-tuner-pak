+/* Tuner: a packet's time on its playlist's continuous timeline (a jump of more than 2 s joined). */
+static int64_t joined_ts(struct playlist *pls, int64_t dts)
+{
+    int64_t t;
+    if (dts == AV_NOPTS_VALUE)
+        return AV_NOPTS_VALUE;
+    t = av_rescale_q(dts, get_timebase(pls), MPEG_TIME_BASE_Q);
+    if (pls->join_last != AV_NOPTS_VALUE) {
+        int64_t d = t + pls->join_off - pls->join_last;
+        if (d > 2 * 90000 || d < -2 * 90000)
+            pls->join_off = pls->join_last - t;
+    }
+    pls->join_last = t + pls->join_off;
+    return pls->join_last;
+}
